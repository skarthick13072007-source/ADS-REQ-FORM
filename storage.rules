rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /requests/{allPaths=**} {
      // Allow public users to upload but not read or list
      allow write: if true;
      
      // Only authorized admins can read uploaded files
      allow read: if isAuthorizedAdmin();
      
      // Only super admins can delete files
      allow delete: if isSuperAdmin();
    }

    function isAuthorizedAdmin() {
      return request.auth != null && 
             firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['super_admin', 'admin', 'viewer'];
    }
    
    function isSuperAdmin() {
      return request.auth != null && 
             firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }
  }
}
